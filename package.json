{
	"name": "imagination-archive",
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.14.1",
		"@types/picomatch": "^4.0.3",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"copy-webpack-plugin": "^13.0.0",
		"css-loader": "^7.1.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"html-inline-script-webpack-plugin": "^3.2.1",
		"html-webpack-plugin": "^5.6.3",
		"husky": "^9.1.7",
		"js-yaml": "^5.2.3",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"webpack": "^5.99.5",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"watch": "webpack --watch --mode development",
		"build": "webpack --mode production",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"tune": "node --import tsx test/tune.ts",
		"sample": "node --import tsx test/sample.ts",
		"probe": "node --import tsx test/probe.ts",
		"lint": "eslint .",
		"fix": "yarn lint --fix",
		"pretty": "yarn prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{yml,yaml,md,json,ts,js,html,css}": "prettier --write"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 120
	}
}
