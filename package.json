{
	"name": "imagination-archive",
	"license": "MIT",
	"dependencies": {
		"find-strips": "github:braxtonhall/find-strips#0.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.14.1",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"watch": "find-strips build config.yaml dist --mode development --watch",
		"build": "find-strips build config.yaml dist",
		"serve": "find-strips serve dist",
		"check": "find-strips check config.yaml",
		"test": "node --import tsx --test \"test/tuning/*.test.ts\"",
		"tune": "node --import tsx test/tuning/tune.ts",
		"sample": "node --import tsx test/tuning/sample.ts",
		"probe": "node --import tsx test/tuning/probe.ts",
		"candidates": "find-strips candidates config.yaml",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"fix": "yarn lint --fix",
		"pretty": "yarn prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{yml,yaml,md,json,ts,js,html,css}": "prettier --write"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 120
	}
}
