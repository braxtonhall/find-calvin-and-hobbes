# Copy to `.env` to set the build's deployment settings locally. Each is also an Actions variable of the
# same name; `config.yaml` explains them.

# The site's address; it turns on the canonical tags, sitemap and CNAME, and may mount the site under a path.
SITE_URL=https://example.com

# `html` writes credits.html; `directory` writes credits/index.html, for a host that needs it.
# PAGE_LAYOUT=html

# `false` leaves the correction link off every page.
# CORRECTIONS=true

# Experimental cloud saves: the address of a bobs-sink, or `false`.
# CLOUD_SAVES=false
