{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"types": ["node"],
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noImplicitAny": true
	},
	"include": ["test"],
	"exclude": ["node_modules"]
}
